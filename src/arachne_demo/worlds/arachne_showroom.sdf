      <cast_shadows>true</cast_shadows>
      <intensity>1.4</intensity>
      <direction>0.45 0.55 -0.72</direction>
      <diffuse>0.95 0.92 0.86 1</diffuse>
      <specular>0.45 0.42 0.38 1</specular>
