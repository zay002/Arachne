<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">
  <xacro:macro name="arachne_lidar" params="parent xyz:='0.28 0 0.19' rpy:='0 0 0'">
    <link name="lidar_link">
      <visual>
        <origin xyz="0 0 0.035" rpy="0 0 0"/>
        <geometry>
          <cylinder radius="0.055" length="0.07"/>
        </geometry>
        <material name="arachne_sensor"/>
      </visual>
      <collision>
        <origin xyz="0 0 0.035" rpy="0 0 0"/>
        <geometry>
          <cylinder radius="0.055" length="0.07"/>
        </geometry>
      </collision>
      <xacro:cylinder_inertial mass="0.35" radius="0.055" length="0.07" axis="z"/>
    </link>
    <joint name="lidar_joint" type="fixed">
      <parent link="${parent}"/>
      <child link="lidar_link"/>
      <origin xyz="${xyz}" rpy="${rpy}"/>
    </joint>
  </xacro:macro>
</robot>
