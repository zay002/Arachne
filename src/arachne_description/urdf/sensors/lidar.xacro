<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">
  <xacro:macro name="arachne_lidar" params="parent xyz:='0.28 0 0.19' rpy:='0 0 0'">
    <link name="lidar_link">
      <visual>
        <origin xyz="0 0 0.03895" rpy="0 0 0"/>
        <geometry>
          <cylinder radius="0.051" length="0.0779"/>
        </geometry>
        <material name="arachne_sensor"/>
      </visual>
      <visual>
        <origin xyz="0 0 0.085" rpy="0 0 0"/>
        <geometry>
          <cylinder radius="0.035" length="0.012"/>
        </geometry>
        <material name="arachne_dark"/>
      </visual>
      <collision>
        <origin xyz="0 0 0.03895" rpy="0 0 0"/>
        <geometry>
          <cylinder radius="0.051" length="0.0779"/>
        </geometry>
      </collision>
      <xacro:cylinder_inertial mass="0.8" radius="0.051" length="0.0779" axis="z"/>
    </link>
    <joint name="lidar_joint" type="fixed">
      <parent link="${parent}"/>
      <child link="lidar_link"/>
      <origin xyz="${xyz}" rpy="${rpy}"/>
    </joint>
  </xacro:macro>
</robot>
