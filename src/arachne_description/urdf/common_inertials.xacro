<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">
  <xacro:macro name="box_inertial" params="mass x y z">
    <inertial>
      <mass value="${mass}"/>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <inertia
        ixx="${mass * (y*y + z*z) / 12.0}"
        ixy="0.0"
        ixz="0.0"
        iyy="${mass * (x*x + z*z) / 12.0}"
        iyz="0.0"
        izz="${mass * (x*x + y*y) / 12.0}"/>
    </inertial>
  </xacro:macro>

  <xacro:macro name="cylinder_inertial" params="mass radius length axis">
    <inertial>
      <mass value="${mass}"/>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <xacro:if value="${axis == 'x'}">
        <inertia
          ixx="${0.5 * mass * radius * radius}"
          ixy="0.0"
          ixz="0.0"
          iyy="${mass * (3.0 * radius * radius + length * length) / 12.0}"
          iyz="0.0"
          izz="${mass * (3.0 * radius * radius + length * length) / 12.0}"/>
      </xacro:if>
      <xacro:if value="${axis == 'y'}">
        <inertia
          ixx="${mass * (3.0 * radius * radius + length * length) / 12.0}"
          ixy="0.0"
          ixz="0.0"
          iyy="${0.5 * mass * radius * radius}"
          iyz="0.0"
          izz="${mass * (3.0 * radius * radius + length * length) / 12.0}"/>
      </xacro:if>
      <xacro:if value="${axis == 'z'}">
        <inertia
          ixx="${mass * (3.0 * radius * radius + length * length) / 12.0}"
          ixy="0.0"
          ixz="0.0"
          iyy="${mass * (3.0 * radius * radius + length * length) / 12.0}"
          iyz="0.0"
          izz="${0.5 * mass * radius * radius}"/>
      </xacro:if>
    </inertial>
  </xacro:macro>
</robot>
