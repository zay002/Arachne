<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">
  <xacro:property name="demo_aubo_shoulder" value="1.664"/>
  <xacro:property name="demo_aubo_upperArm" value="0.034"/>
  <xacro:property name="demo_aubo_foreArm" value="-1.324"/>
  <xacro:property name="demo_aubo_wrist1" value="0.034"/>
  <xacro:property name="demo_aubo_wrist2" value="-1.732"/>
  <xacro:property name="demo_aubo_wrist3" value="0.0"/>

  <xacro:macro name="arachne_gazebo_surface" params="link mu1:=0.9 mu2:=0.9">
    <gazebo reference="${link}">
      <mu1>${mu1}</mu1>
      <mu2>${mu2}</mu2>
      <kp>1000000.0</kp>
      <kd>100.0</kd>
    </gazebo>
  </xacro:macro>

  <xacro:macro name="arachne_gazebo_plugins" params="gripper_type">
    <xacro:arachne_gazebo_surface link="base_link" mu1="1.0" mu2="1.0"/>
    <xacro:arachne_gazebo_surface link="front_left_wheel_link" mu1="1.2" mu2="1.2"/>
    <xacro:arachne_gazebo_surface link="front_right_wheel_link" mu1="1.2" mu2="1.2"/>
    <xacro:arachne_gazebo_surface link="rear_left_wheel_link" mu1="1.2" mu2="1.2"/>
    <xacro:arachne_gazebo_surface link="rear_right_wheel_link" mu1="1.2" mu2="1.2"/>

    <gazebo>
      <plugin filename="gz-sim-diff-drive-system" name="gz::sim::systems::DiffDrive">
        <left_joint>front_left_wheel</left_joint>
        <left_joint>rear_left_wheel</left_joint>
        <right_joint>front_right_wheel</right_joint>
        <right_joint>rear_right_wheel</right_joint>
        <wheel_separation>0.58306</wheel_separation>
        <wheel_radius>0.16459</wheel_radius>
        <topic>/cmd_vel</topic>
        <odom_topic>/gz/odom</odom_topic>
        <frame_id>odom</frame_id>
        <child_frame_id>base_link</child_frame_id>
        <odom_publish_frequency>30</odom_publish_frequency>
        <max_linear_velocity>0.8</max_linear_velocity>
        <min_linear_velocity>-0.8</min_linear_velocity>
        <max_angular_velocity>1.4</max_angular_velocity>
        <min_angular_velocity>-1.4</min_angular_velocity>
        <max_linear_acceleration>1.2</max_linear_acceleration>
        <min_linear_acceleration>-1.2</min_linear_acceleration>
        <max_angular_acceleration>2.2</max_angular_acceleration>
        <min_angular_acceleration>-2.2</min_angular_acceleration>
      </plugin>

      <plugin
        filename="gz-sim-joint-trajectory-controller-system"
        name="gz::sim::systems::JointTrajectoryController">
        <joint_name>aubo_shoulder_joint</joint_name>
        <initial_position>${demo_aubo_shoulder}</initial_position>
        <position_p_gain>80</position_p_gain>
        <position_d_gain>8</position_d_gain>
        <position_cmd_min>-100</position_cmd_min>
        <position_cmd_max>100</position_cmd_max>

        <joint_name>aubo_upperArm_joint</joint_name>
        <initial_position>${demo_aubo_upperArm}</initial_position>
        <position_p_gain>100</position_p_gain>
        <position_d_gain>10</position_d_gain>
        <position_cmd_min>-120</position_cmd_min>
        <position_cmd_max>120</position_cmd_max>

        <joint_name>aubo_foreArm_joint</joint_name>
        <initial_position>${demo_aubo_foreArm}</initial_position>
        <position_p_gain>90</position_p_gain>
        <position_d_gain>9</position_d_gain>
        <position_cmd_min>-100</position_cmd_min>
        <position_cmd_max>100</position_cmd_max>

        <joint_name>aubo_wrist1_joint</joint_name>
        <initial_position>${demo_aubo_wrist1}</initial_position>
        <position_p_gain>50</position_p_gain>
        <position_d_gain>5</position_d_gain>
        <position_cmd_min>-60</position_cmd_min>
        <position_cmd_max>60</position_cmd_max>

        <joint_name>aubo_wrist2_joint</joint_name>
        <initial_position>${demo_aubo_wrist2}</initial_position>
        <position_p_gain>50</position_p_gain>
        <position_d_gain>5</position_d_gain>
        <position_cmd_min>-60</position_cmd_min>
        <position_cmd_max>60</position_cmd_max>

        <joint_name>aubo_wrist3_joint</joint_name>
        <initial_position>${demo_aubo_wrist3}</initial_position>
        <position_p_gain>40</position_p_gain>
        <position_d_gain>4</position_d_gain>
        <position_cmd_min>-40</position_cmd_min>
        <position_cmd_max>40</position_cmd_max>
      </plugin>

      <plugin filename="gz-sim-joint-state-publisher-system" name="gz::sim::systems::JointStatePublisher">
        <joint_name>front_left_wheel</joint_name>
        <joint_name>rear_left_wheel</joint_name>
        <joint_name>front_right_wheel</joint_name>
        <joint_name>rear_right_wheel</joint_name>
        <joint_name>aubo_shoulder_joint</joint_name>
        <joint_name>aubo_upperArm_joint</joint_name>
        <joint_name>aubo_foreArm_joint</joint_name>
        <joint_name>aubo_wrist1_joint</joint_name>
        <joint_name>aubo_wrist2_joint</joint_name>
        <joint_name>aubo_wrist3_joint</joint_name>
      </plugin>
    </gazebo>

    <xacro:if value="${gripper_type == 'ms42dc'}">
      <xacro:arachne_gazebo_surface link="ms42dc_base_link" mu1="0.8" mu2="0.8"/>
      <xacro:arachne_gazebo_surface link="ms42dc_left_finger_link" mu1="1.1" mu2="1.1"/>
      <xacro:arachne_gazebo_surface link="ms42dc_right_finger_link" mu1="1.1" mu2="1.1"/>
      <gazebo>
        <plugin filename="gz-sim-joint-position-controller-system" name="gz::sim::systems::JointPositionController">
          <joint_name>ms42dc_left_finger_joint</joint_name>
          <topic>/arachne/gazebo/ms42dc_left_finger/command</topic>
          <p_gain>6.0</p_gain>
          <i_gain>0.0</i_gain>
          <d_gain>0.2</d_gain>
          <cmd_max>2.0</cmd_max>
          <cmd_min>-2.0</cmd_min>
        </plugin>
        <plugin filename="gz-sim-joint-position-controller-system" name="gz::sim::systems::JointPositionController">
          <joint_name>ms42dc_right_finger_joint</joint_name>
          <topic>/arachne/gazebo/ms42dc_right_finger/command</topic>
          <p_gain>6.0</p_gain>
          <i_gain>0.0</i_gain>
          <d_gain>0.2</d_gain>
          <cmd_max>2.0</cmd_max>
          <cmd_min>-2.0</cmd_min>
        </plugin>
      </gazebo>
    </xacro:if>
  </xacro:macro>
</robot>
