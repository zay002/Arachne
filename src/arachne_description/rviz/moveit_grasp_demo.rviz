Panels:
  - Class: rviz_common/Displays
    Name: Displays
Visualization Manager:
  Class: ""
  Displays:
    - Class: rviz_default_plugins/Grid
      Enabled: false
      Name: Grid
      Plane: XY
      Reference Frame: base_link
    - Class: rviz_default_plugins/RobotModel
      Alpha: 1
      Description Source: Topic
      Description Topic:
        Depth: 5
        Durability Policy: Transient Local
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /robot_description
      Enabled: true
      Name: RobotModel
      Visual Enabled: true
      Collision Enabled: true
    - Class: rviz_default_plugins/TF
      Enabled: false
      Name: TF
    - Class: rviz_default_plugins/MarkerArray
      Enabled: true
      Name: UsefulDirectionMarkers
      Topic:
        Depth: 10
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /arachne/model/direction_markers
    - Class: rviz_default_plugins/MarkerArray
      Enabled: true
      Name: SyntheticVisionAndWaypoints
      Topic:
        Depth: 10
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /arachne/grasp_preview/markers
    - Class: rviz_default_plugins/Path
      Enabled: true
      Name: SemanticTaskPath
      Topic:
        Depth: 5
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /arachne/grasp_preview/path
      Line Style: Lines
      Line Width: 0.035
      Color: 0; 180; 255
  Enabled: true
  Global Options:
    Background Color: 42; 45; 48
    Fixed Frame: base_link
    Frame Rate: 30
  Name: root
  Tools:
    - Class: rviz_default_plugins/Interact
    - Class: rviz_default_plugins/MoveCamera
    - Class: rviz_default_plugins/Select
  Value: true
Views:
  Current:
    Class: rviz_default_plugins/Orbit
    Distance: 1.65
    Focal Point:
      X: 0.18
      Y: 0
      Z: 0.22
    Name: Current View
    Pitch: 0.45
    Target Frame: base_link
    Yaw: 0.78
Window Geometry:
  Width: 1280
  Height: 820
