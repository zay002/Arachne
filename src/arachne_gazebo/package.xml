<?xml version="1.0"?>
<package format="3">
  <name>arachne_gazebo</name>
  <version>0.1.0</version>
  <description>Gazebo-specific helper nodes for the Arachne demo.</description>
  <maintainer email="maintainer@example.com">Arachne Maintainers</maintainer>
  <license>MIT</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <depend>geometry_msgs</depend>
  <depend>rclcpp</depend>
  <depend>sensor_msgs</depend>
  <depend>std_msgs</depend>
  <depend>gz_msgs_vendor</depend>
  <depend>gz_transport_vendor</depend>

  <test_depend>ament_lint_auto</test_depend>
  <test_depend>ament_lint_common</test_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
