# Copy this file to ~/.config/arachne/agent.env or /etc/arachne/agent.env.
# Never commit the real file. Keep permissions restricted:
#   chmod 600 ~/.config/arachne/agent.env

# Provider keys are used by the external agent process, not by arachne_agent_bridge.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=

# Optional external agent runtime settings.
ARACHNE_AGENT_MODEL=
ARACHNE_AGENT_BASE_URL=
ARACHNE_AGENT_LOG_LEVEL=info
