# ROS/colcon generated files
build/
install/
log/
.colcon/
.ros/
.vscode

# Godot editor/import cache and generated asset links.
godot/**/.godot/
godot/**/.import/
godot/**/assets/generated/
godot/**/assets/vendor/*
!godot/**/assets/vendor/README.md
!godot/**/assets/vendor/README.zh-CN.md
!godot/**/assets/vendor/.gdignore
# Python generated files
*.pyc
__pycache__/
.pytest_cache/

# Local teach/replay recordings from demos.
recordings/

# Internal stage reports are local working notes, not public docs.
docs/reports/

# Local planning notes are not part of the public repository.
plan.md
PLAN.md

# Downloaded upstream repositories and bulky local reference material stay out of git.
third_party/*
src/vendor/*
!src/vendor/aubo_description
!src/vendor/dh_ag95_description
!src/vendor/scout_description

